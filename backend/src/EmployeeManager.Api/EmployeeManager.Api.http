@EmployeeManager.Api_HostAddress = http://localhost:5062

GET {{EmployeeManager.Api_HostAddress}}/api/health
Accept: application/json

###

POST {{EmployeeManager.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "margaret.hayes@example.com",
  "password": "Passw0rd!"
}

> {% client.global.set("token", response.body.accessToken); %}

###

GET {{EmployeeManager.Api_HostAddress}}/api/auth/me
Authorization: Bearer {{token}}

###

GET {{EmployeeManager.Api_HostAddress}}/api/employees/org-chart
Authorization: Bearer {{token}}

###

POST {{EmployeeManager.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "grace.turner@example.com",
  "password": "Passw0rd!"
}

> {% client.global.set("adminToken", response.body.accessToken); %}

###

GET {{EmployeeManager.Api_HostAddress}}/api/employees
Authorization: Bearer {{adminToken}}

###

POST {{EmployeeManager.Api_HostAddress}}/api/employees
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "firstName": "Nora",
  "lastName": "Quinn",
  "email": "nora.quinn@example.com",
  "jobTitle": "Backend Developer",
  "hireDate": "2026-11-02",
  "managerId": null,
  "role": "Employee",
  "password": "Passw0rd!"
}

> {% client.global.set("employeeId", response.body.id); %}

###

PUT {{EmployeeManager.Api_HostAddress}}/api/employees/{{employeeId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "firstName": "Nora",
  "lastName": "Quinn",
  "email": "nora.quinn@example.com",
  "jobTitle": "Senior Backend Developer",
  "hireDate": "2026-11-02",
  "managerId": null,
  "role": "Manager"
}

###

DELETE {{EmployeeManager.Api_HostAddress}}/api/employees/{{employeeId}}
Authorization: Bearer {{adminToken}}

###

GET {{EmployeeManager.Api_HostAddress}}/api/projects/managed
Authorization: Bearer {{token}}

###

GET {{EmployeeManager.Api_HostAddress}}/api/projects/mine
Authorization: Bearer {{token}}

###

POST {{EmployeeManager.Api_HostAddress}}/api/projects
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Office move",
  "description": "Plan and run the move to the new office.",
  "memberIds": []
}

> {% client.global.set("projectId", response.body.id); %}

###

GET {{EmployeeManager.Api_HostAddress}}/api/projects/{{projectId}}
Authorization: Bearer {{token}}

###

PUT {{EmployeeManager.Api_HostAddress}}/api/projects/{{projectId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Office move 2027",
  "description": null,
  "memberIds": []
}

###

DELETE {{EmployeeManager.Api_HostAddress}}/api/projects/{{projectId}}
Authorization: Bearer {{token}}

